# LikeCleaner backend settings (all read in app/core/config.py).
# Copy this file to `.env` and fill in the values. Never commit `.env` or paste its values into chat.
# A blank value means "use the default" where one is noted.

# Google OAuth client ID. Google Cloud Console → Google Auth Platform → Clients. Required from P2-2.
GOOGLE_CLIENT_ID=

# Google OAuth client secret, shown next to the client ID. Required from P2-2.
GOOGLE_CLIENT_SECRET=

# Where new access requests are announced (SPEC.md 3-3). Blank = hajin300@gmail.com.
ADMIN_EMAIL=

# Gmail account that sends the announcement; the admin's own Gmail (DECISIONS.md 40). Required from P2-3.
SMTP_USER=

# 16-character Gmail app password for SMTP_USER (myaccount.google.com/apppasswords). Required from P2-3.
SMTP_APP_PASSWORD=

# Key that encrypts stored refresh tokens. Never change it once used, or saved tokens become unreadable.
# Make one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Long random string that signs the login cookie. Changing it signs everyone out.
# Make one: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# YouTube API units per day for the whole project (SPEC.md 4-1). Blank = 10000.
DAILY_QUOTA=

# Database location. Blank = backend/data/likecleaner.db
# Format: sqlite+aiosqlite:////absolute/path/to/likecleaner.db
DATABASE_URL=
