# LikeCleaner backend settings.
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Google OAuth (Google Cloud Console → Google Auth Platform → Clients) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Admin notification mail (DECISIONS.md 40: SMTP_USER is the admin's own Gmail) ---
ADMIN_EMAIL=hajin300@gmail.com
SMTP_USER=hajin300@gmail.com
# 16-character Gmail app password (myaccount.google.com/apppasswords)
SMTP_APP_PASSWORD=

# --- Generated secrets (keep them; changing TOKEN_ENCRYPTION_KEY makes stored tokens unreadable) ---
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Any long random string: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Quota ---
DAILY_QUOTA=10000

# --- Database (optional; default is backend/data/likecleaner.db) ---
# DATABASE_URL=sqlite+aiosqlite:///absolute/path/to/likecleaner.db
